DJANGO_SECRET_KEY=change-me-for-local-use
DJANGO_DEBUG=0
DB_NAME=brain_parser
DB_USER=postgres
DB_PASSWORD=your_postgresql_password
DB_HOST=127.0.0.1
DB_PORT=5432
BROWSER_HEADLESS=0

# Optional only for a non-standard PostgreSQL installation; Windows standard paths are auto-detected:
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe
